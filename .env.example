# ══════════════════════════════════════════════════════════════════════════════
# SchoolMS Ghana — Environment Configuration
# Copy this file to .env and fill in all required values.
# ══════════════════════════════════════════════════════════════════════════════

# ── Application ───────────────────────────────────────────────────────────────
APP_NAME="SchoolMS Ghana"
APP_ENV=local
APP_KEY=
APP_DEBUG=false          # NEVER true in production — exposes stack traces and DB credentials
APP_URL=http://localhost
APP_DOMAIN=schoolms.com.gh          # Root domain for subdomain routing

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# ── Production Super Admin (used by SuperAdminSeeder) ────────────────────────
# REQUIRED in production before running php artisan db:seed
SUPER_ADMIN_EMAIL=superadmin@schoolms.com.gh
SUPER_ADMIN_PASSWORD=                       # Set a strong password — never commit this

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error          # Use 'debug' locally; 'error' in production — debug logs contain PII

# ── Database ──────────────────────────────────────────────────────────────────
# Production: use mysql
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=schoolms
DB_USERNAME=root
DB_PASSWORD=

# ── Session & Cache ───────────────────────────────────────────────────────────
# PRODUCTION: use SESSION_DRIVER=redis  (requires REDIS_* vars below)
# LOCAL:      database is fine for development
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true     # Required — sessions contain admin/teacher identity and student lookup state
SESSION_PATH=/
SESSION_DOMAIN=.schoolms.com.gh     # Leading dot covers all subdomains

# PRODUCTION: use CACHE_STORE=redis — subscription status caching and
#             other hot-path caches require a real cache (not file/database).
# LOCAL:      file or database is acceptable.
CACHE_STORE=redis
# CACHE_PREFIX=

# ── Queue ─────────────────────────────────────────────────────────────────────
# REQUIRED: must be 'redis' for Laravel Horizon to work.
# Using 'database' means Horizon starts but watches the wrong connection.
QUEUE_CONNECTION=redis

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# ── Storage disks ─────────────────────────────────────────────────────────────
# MEDIA_DISK   — where public assets (logos, images) are stored.
#   local dev:  public  (served via storage:link)
#   production: s3      (requires AWS_* vars below)
# PRIVATE_DISK — where internal files (exports, backups) are stored.
#   local dev:  local
#   production: s3
MEDIA_DISK=public
PRIVATE_DISK=local

# ── Mail ──────────────────────────────────────────────────────────────────────
# Development: use 'log' (emails go to laravel.log)
# Staging:     use Mailtrap
# Production:  use smtp (Mailgun, Postmark, SES, etc.)

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@schoolms.com.gh"
MAIL_FROM_NAME="${APP_NAME}"

# Mailtrap (staging/testing):
# MAIL_MAILER=smtp
# MAIL_HOST=sandbox.smtp.mailtrap.io
# MAIL_PORT=2525
# MAIL_USERNAME=your_mailtrap_username
# MAIL_PASSWORD=your_mailtrap_password

# ── Paystack ──────────────────────────────────────────────────────────────────
# Get keys from https://dashboard.paystack.com/#/settings/developer
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx

# ── Hubtel SMS / WhatsApp ─────────────────────────────────────────────────────
# Get credentials from https://developers.hubtel.com
# HUBTEL_SENDER_ID must be pre-approved (max 11 chars, letters only)
HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=
HUBTEL_SENDER_ID=SchoolMS

# ── Moolre ────────────────────────────────────────────────────────────────────
# Get credentials from your Moolre merchant dashboard
MOOLRE_ACCOUNT_NUMBER=your_moolre_account_number
MOOLRE_PUBLIC_KEY=your_moolre_public_key

# ── Billing Configuration ─────────────────────────────────────────────────────
BILLING_GATEWAY=paystack            # Default gateway: paystack | moolre
BILLING_GRACE_DAYS=5                # Days of grace after term end before lock
BILLING_CACHE_TTL=5                 # Subscription status cache TTL (minutes)

# Subscription plan prices (GHS)
PLAN_BASIC_AMOUNT=500
PLAN_STANDARD_AMOUNT=850
PLAN_PREMIUM_AMOUNT=1200

# ── Redis (required in production for Horizon + cache + queues) ───────────────
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ── Redis database separation (prevents cache/queue/session key collisions) ───
# DB 0 = queue (Horizon default)
# DB 1 = cache
# DB 2 = session
REDIS_QUEUE_DB=0
REDIS_CACHE_DB=1
REDIS_SESSION_DB=2

# ── Sentry Error Monitoring ───────────────────────────────────────────────────
# Get your DSN from https://sentry.io — create a project of type "Laravel"
# Leave empty to disable Sentry in local development.
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1     # 10% of transactions are traced (adjust in prod)
SENTRY_PROFILES_SAMPLE_RATE=0.1   # 10% profiling (requires sentry Performance add-on)

# ── Laravel Horizon ───────────────────────────────────────────────────────────
# Horizon provides a dashboard at /horizon — restrict access in production.
# HORIZON_NAME defaults to APP_NAME.
# In production, set QUEUE_CONNECTION=redis so Horizon has something to supervise.
HORIZON_NAME="${APP_NAME}"

# ── AWS S3 ────────────────────────────────────────────────────────────────────
# Required in production when MEDIA_DISK=s3 or PRIVATE_DISK=s3.
# Create two buckets: one public (logos/images) and one private (exports).
# Set AWS_BUCKET to the public bucket; configure the private bucket in code if needed.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-west-1            # Choose closest to Ghana (London/Frankfurt)
AWS_BUCKET=                             # Public media bucket name
AWS_URL=                                # Optional: CDN URL (e.g. CloudFront)
AWS_ENDPOINT=                           # Optional: S3-compatible endpoint (e.g. Cloudflare R2)
AWS_USE_PATH_STYLE_ENDPOINT=false

# ── Memcached (not needed unless using memcached cache driver) ────────────────
MEMCACHED_HOST=127.0.0.1

VITE_APP_NAME="${APP_NAME}"
