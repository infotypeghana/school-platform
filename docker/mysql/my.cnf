[mysqld]
# ── Charset ───────────────────────────────────────────────────────────────────
character-set-server  = utf8mb4
collation-server      = utf8mb4_unicode_ci

# ── InnoDB ────────────────────────────────────────────────────────────────────
# Set innodb_buffer_pool_size to ~70% of available RAM on a dedicated DB server
innodb_buffer_pool_size     = 512M
innodb_log_file_size        = 256M
innodb_flush_log_at_trx_commit = 1   # Full ACID compliance
innodb_flush_method         = O_DIRECT

# ── Connections ───────────────────────────────────────────────────────────────
max_connections        = 200
wait_timeout           = 600
interactive_timeout    = 600

# ── Query cache (disabled in MySQL 8 — use Redis) ────────────────────────────
# query_cache_type = 0

# ── Slow query log ────────────────────────────────────────────────────────────
slow_query_log         = 1
slow_query_log_file    = /var/log/mysql/slow.log
long_query_time        = 2

# ── Security ──────────────────────────────────────────────────────────────────
local_infile           = 0
skip-symbolic-links

[client]
default-character-set = utf8mb4
