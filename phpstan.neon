includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    # Level 4 — catches undefined methods, wrong argument types, null dereferences.
    # Level 5 adds dead-code checks that generate many false positives on ?-> operators
    # used defensively throughout the codebase. Raise incrementally as annotations mature.
    level: 4

    paths:
        - app

    excludePaths:
        # TrustProxies is a Laravel stub — may not exist in all installations
        - app/Http/Middleware/TrustProxies.php (?)

    # Treat these as always-bound in the IoC container so PHPStan doesn't complain
    # about app('currentTenant') returning mixed.
    ignoreErrors:
        # Blade view() calls return View which PHPStan can't statically type
        - '#Call to an undefined method Illuminate\\View\\View#'

        # Dynamic magic accessors on Eloquent models
        - '#Access to an undefined property App\\Models\\[A-Za-z]+::\$#'
        # AuditObserver accepts base Model — magic properties not visible at that level
        - '#Access to an undefined property Illuminate\\Database\\Eloquent\\Model::\$#'

        # Collection::map() closures — Larastan cannot always resolve complex closure
        # return types when the collection element type involves generic parameters.
        - '#Parameter #1 \$callback of method .+::map\(\) contains unresolvable type#'

        # Dynamic Eloquent relationship methods called on the base Model type.
        # Larastan does not narrow the model type inside generic collection iterators,
        # so HasMany/HasOne methods appear undefined from PHPStan's perspective.
        - '#Call to an undefined method Illuminate\\Database\\Eloquent\\Model::[a-z]+\(\)#'
