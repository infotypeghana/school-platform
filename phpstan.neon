includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    # Level 4 catches undefined methods, wrong argument types, and dead code.
    # Raise to 5+ incrementally as PHPDoc annotations mature across the codebase.
    level: 4

    paths:
        - app

    excludePaths:
        # TrustProxies is a Laravel boilerplate stub — may not exist in all setups
        - app/Http/Middleware/TrustProxies.php (?)

    # Don't fail when an ignoreErrors pattern no longer matches any error.
    # Patterns become stale as code is fixed; we prefer not to block CI on cleanup.
    reportUnmatchedIgnoredErrors: false

    ignoreErrors:

        # ── Eloquent magic property / method access ───────────────────────────
        # Eloquent models expose columns and relations as dynamic magic properties;
        # PHPStan cannot see them without a generated IDE helper.
        - '#Access to an undefined property App\\Models\\[A-Za-z]+::\$#'
        # AuditObserver accepts the base Model type; tenant_id is not declared there.
        - '#Access to an undefined property Illuminate\\Database\\Eloquent\\Model::\$#'
        # Dynamic HasMany / HasOne relation calls inside collection closures where
        # Larastan cannot narrow the element type to the concrete model subclass.
        - '#Call to an undefined method Illuminate\\Database\\Eloquent\\Model::[a-zA-Z]+\(\)#'

        # ── Defensive nullsafe / dead-code false positives ────────────────────
        # The codebase uses ?-> and ?? defensively for forward-compatibility and
        # clarity. PHPStan level 4 flags these when the type is provably non-null,
        # but the defensive style is intentional and harmless.
        - '#Using nullsafe (property access|method call)#'
        - '#Right side of && is always true#'
        - '#Negated boolean expression is always true#'
        - '#Match arm comparison between .+ is always true#'
        - '#Match expression does not handle remaining value#'
        # Defensive ?? on array offsets that PHPStan proves always exist.
        - '#Offset .+ on left side of \?\? always exists and is not nullable#'
        # Bounded integer comparisons flagged as always-false (e.g. year/day range checks).
        - '#Comparison operation .+ is always (true|false)#'

        # ── HasTenantScope trait — static:: / new static() patterns ──────────
        # The trait calls its own private helpers via static:: so that subclass
        # overrides work correctly in a multi-model context. PHPStan flags private
        # methods called through static:: as potentially unsafe; in practice every
        # concrete model class is final at runtime, so this is safe.
        - '#Unsafe call to private method .+::(resolveTenantId|generateAdmissionNumber)\(\) through static::#'
        # new static() in Eloquent boot / factory methods is a standard Laravel idiom.
        - '#Unsafe usage of new static\(\)#'

        # ── BelongsTo PHPDoc generic mismatch ────────────────────────────────
        # Larastan types the second BelongsTo type parameter as $this(ClassName)
        # (late-static-binding placeholder). A declared @return BelongsTo<R, Model>
        # does not match $this(Model) exactly. Suppress until Larastan resolves
        # the $this generic automatically.
        - '#should return .+BelongsTo.+ but returns .+BelongsTo.+\$this\(#'

        # ── Eloquent first() / find() return type through custom scopes ───────
        # Methods that declare a concrete ?Model return type but Larastan infers
        # Model|null because withoutTenantScope() and similar custom query macros
        # break the Eloquent Builder generic chain.
        - '#should return App\\Models\\.+\|null but returns Illuminate\\Database\\Eloquent\\Model\|null#'

        # ── Dead infrastructure code (acceptable in a service/device layer) ───
        # ZKTecoService keeps socket state in write-only properties for debugging
        # purposes; AdmsController stores $zk for potential future commands.
        - '#Property .+ is never read, only written#'
        - '#Constant .+ is unused#'
