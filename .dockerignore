# Version control
.git
.gitignore

# Dev tooling
node_modules
.env
.env.*
!.env.example

# Tests & CI
tests
.github
phpunit.xml
phpstan.neon
*.test.js

# IDE & OS
.idea
.vscode
*.DS_Store
Thumbs.db

# Docker compose and Dockerfile itself (not needed in image)
# NOTE: docker/ directory is intentionally NOT excluded here —
# the Dockerfile COPYs docker/php/php.ini and docker/php/php-fpm.conf
# into the image during the build stage. The docker/ directory is then
# removed inside the image via `RUN rm -rf docker` in the production stage.
docker-compose*.yml
Dockerfile

# Compiled output that will be re-built inside image
public/build
public/hot

# Logs & temp
storage/logs/*.log
storage/framework/cache
storage/framework/sessions
storage/framework/views
bootstrap/cache/*.php
